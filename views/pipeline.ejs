<%- include('partials/header') %>

<div class="px-4 py-8 sm:px-0">
  <div class="mb-8 border-b border-slate-200/60 pb-5 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-700 text-xs font-bold uppercase tracking-wider mb-3">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
          </span>
          Live Intelligence Pipeline
      </div>
      <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-indigo-800 font-outfit tracking-tight">Antrian Verifikasi Pipeline</h1>
      <p class="mt-2 text-sm text-slate-500 font-medium max-w-2xl">
          Verifikasi manual data OSINT (Confidence Score 40-69%).
      </p>
    </div>
    <div class="flex gap-2">
      <a href="/tracker" class="inline-flex justify-center items-center px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold rounded-xl shadow-lg shadow-slate-900/20 transition-all font-outfit btn-animate">
        <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Kembali ke Tracker
      </a>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white/80 border border-slate-200/60 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">Menunggu Verifikasi</div>
      <div class="text-3xl font-black text-amber-600 mt-2 font-outfit" id="stat-pending"><%= trackingStats?.pendingResults || 0 %></div>
    </div>
    <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-emerald-600 font-bold uppercase tracking-wider">Telah Disetujui</div>
      <div class="text-3xl font-black text-emerald-700 mt-2 font-outfit" id="stat-approved"><%= trackingStats?.approvedResults || 0 %></div>
    </div>
    <div class="bg-rose-50 border border-rose-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-rose-600 font-bold uppercase tracking-wider">Telah Ditolak</div>
      <div class="text-3xl font-black text-rose-700 mt-2 font-outfit" id="stat-rejected"><%= trackingStats?.rejectedResults || 0 %></div>
    </div>
    <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-indigo-600 font-bold uppercase tracking-wider">Total Jejak Digital</div>
      <div class="text-3xl font-black text-indigo-700 mt-2 font-outfit"><%= trackingStats?.totalResults || 0 %></div>
    </div>
  </div>

  <!-- Table Data -->
  <div class="bg-white/60 backdrop-blur-xl border border-white/60 shadow-2xl shadow-slate-200/50 sm:rounded-2xl overflow-hidden ring-1 ring-slate-200/50">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200/60" id="staging-table">
        <thead class="bg-slate-50/50">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider font-outfit">Alumni Database</th>
            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider font-outfit">Data Ditemukan (OSINT)</th>
            <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-slate-500 uppercase tracking-wider font-outfit">Confidence</th>
            <th scope="col" class="px-6 py-4 text-right text-xs font-bold text-slate-500 uppercase tracking-wider font-outfit">Aksi (Admin)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200/60 bg-transparent">
          <% if (pendingResults && pendingResults.length > 0) { %>
            <% pendingResults.forEach(result => { %>
              <tr id="row-<%= result.id %>" class="hover:bg-indigo-50/30 transition-colors duration-200">
                <td class="px-6 py-5">
                  <div class="text-sm font-bold text-slate-900 font-outfit mb-1"><%= result.alumni_name %></div>
                  <a href="<%= result.source_url %>" target="_blank" class="inline-flex items-center text-xs text-indigo-600 hover:text-indigo-800 hover:underline">
                    Lihat Sumber Asli <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm font-semibold text-slate-800"><%= result.extracted_title || 'Posisi tidak diketahui' %></div>
                  <div class="text-xs text-slate-500 mt-1">@ <%= result.extracted_company || 'Perusahaan tidak diketahui' %></div>
                  <div class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <%= result.extracted_location || 'Lokasi tidak diketahui' %>
                  </div>
                </td>
                <td class="px-6 py-5 text-center">
                  <% const score = result.confidence_score; %>
                  <div class="inline-flex items-center justify-center w-12 h-12 rounded-full border-4 <%= score >= 60 ? 'border-amber-400 text-amber-700 bg-amber-50' : 'border-rose-400 text-rose-700 bg-rose-50' %> font-black font-outfit text-sm">
                    <%= score %>%
                  </div>
                </td>
                <td class="px-6 py-5 text-right whitespace-nowrap">
                  <div class="flex flex-col gap-2">
                    <button onclick="handleAction('<%= result.id %>', 'approve')" class="inline-flex justify-center items-center px-4 py-2 text-xs font-bold rounded-lg text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors shadow-sm">
                      <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Verify & Merge Log
                    </button>
                    <button onclick="handleAction('<%= result.id %>', 'reject')" class="inline-flex justify-center items-center px-4 py-2 text-xs font-bold rounded-lg text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors shadow-sm">
                      <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg> Reject as False Pos.
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr id="empty-state">
              <td colspan="4" class="px-6 py-16 text-center text-slate-500">
                <svg class="mx-auto h-16 w-16 text-emerald-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <p class="text-2xl font-bold text-slate-800 font-outfit">All Clear! No Pending Verifications</p>
                <p class="text-sm mt-2 text-slate-500 max-w-md mx-auto">The pipeline currently has no actionable matches. Start the background process to begin scanning public footprints for new updates.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
async function handleAction(id, action) {
  if (!confirm(`Are you sure you want to ${action === 'approve' ? 'approve and merge' : 'reject'} this data profile? Original data safety constraints apply.`)) return;

  const row = document.getElementById(`row-${id}`);
  const buttons = row.querySelectorAll('button');
  buttons.forEach(b => b.disabled = true);

  try {
    const res = await fetch(`/staging/${id}/${action}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note: `Admin: ${action}` })
    });
    
    const data = await res.json();
    if (data.success) {
      // Animation and removal
      row.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        row.remove();
        checkEmptyState();
      }, 300);

      // Update counters
      const pendingEl = document.getElementById('stat-pending');
      pendingEl.textContent = Math.max(0, parseInt(pendingEl.textContent) - 1);
      
      const targetStat = action === 'approve' ? document.getElementById('stat-approved') : document.getElementById('stat-rejected');
      targetStat.textContent = parseInt(targetStat.textContent) + 1;
    } else {
      alert('Error: ' + data.error);
      buttons.forEach(b => b.disabled = false);
    }
  } catch (err) {
    alert('Terjadi kesalahan koneksi.');
    buttons.forEach(b => b.disabled = false);
  }
}

function checkEmptyState() {
  const tbody = document.querySelector('tbody');
  if (tbody.querySelectorAll('tr').length === 0) {
    tbody.innerHTML = `
      <tr id="empty-state">
        <td colspan="4" class="px-6 py-16 text-center text-slate-500">
          <svg class="mx-auto h-16 w-16 text-emerald-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <p class="text-2xl font-bold text-slate-800 font-outfit">All Clear! No Pending Verifications</p>
          <p class="text-sm mt-2 text-slate-500 max-w-md mx-auto">The pipeline currently has no actionable matches. Start the background process to begin scanning public footprints for new updates.</p>
        </td>
      </tr>
    `;
  }
}
</script>

<%- include('partials/footer') %>
