<%- include('partials/header') %>

<div class="px-4 py-8 sm:px-0">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
    <div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-slate-600 tracking-tight font-outfit">Intelligent Tracker</h1>
      <p class="text-sm text-slate-500 mt-1 font-medium">Pelacakan 8 titik data alumni secara otomatis dari sumber publik</p>
    </div>
    <!-- Badge status realtime -->
    <div id="status-badge" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold border
      <%= workerStatus.status === 'running' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200' %>">
      <span class="w-2 h-2 rounded-full <%= workerStatus.status === 'running' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400' %>"></span>
      <%= workerStatus.status === 'running' ? 'Tracker Berjalan' : 'Tracker Siap' %>
    </div>
  </div>

  <!-- Alert Banner -->
  <% const alertMessages = {
    'started'         : { text: 'Tracker dimulai! Proses berjalan di background — 1 alumni setiap 3–6 detik.', color: 'emerald' },
    'stopped'         : { text: 'Queue dihentikan dan dikosongkan.', color: 'amber' },
    'already-running' : { text: 'Tracker sedang berjalan. Tunggu hingga selesai atau klik Hentikan.', color: 'amber' },
    'error'           : { text: 'Terjadi kesalahan. Lihat console untuk detail.', color: 'rose' },
  }; %>
  <% if (alertParam && alertMessages[alertParam]) {
    const a = alertMessages[alertParam]; %>
  <div class="mb-6 px-4 py-3 rounded-xl bg-<%= a.color %>-50 border border-<%= a.color %>-200 text-<%= a.color %>-800 text-sm font-semibold flex items-center gap-2">
    <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <%- a.text %>
  </div>
  <% } %>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white/80 border border-slate-200/60 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">Total Alumni</div>
      <div class="text-3xl font-black text-slate-800 mt-2 font-outfit"><%= stats.total.toLocaleString('id-ID') %></div>
    </div>
    <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-emerald-600 font-bold uppercase tracking-wider">Teridentifikasi</div>
      <div class="text-3xl font-black text-emerald-700 mt-2 font-outfit"><%= stats.teridentifikasi.toLocaleString('id-ID') %></div>
    </div>
    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-amber-600 font-bold uppercase tracking-wider">Perlu Verifikasi</div>
      <div class="text-3xl font-black text-amber-700 mt-2 font-outfit">
        <a href="/staging" class="hover:underline"><%= stats.perluVerifikasi.toLocaleString('id-ID') %></a>
      </div>
    </div>
    <div class="bg-rose-50 border border-rose-100 rounded-2xl p-5 shadow-sm text-center sm:text-left">
      <div class="text-xs text-rose-600 font-bold uppercase tracking-wider">Belum Ditemukan</div>
      <div class="text-3xl font-black text-rose-700 mt-2 font-outfit"><%= stats.belumDitemukan.toLocaleString('id-ID') %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Panel Kiri: Control Panel -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <h2 class="text-base font-bold text-slate-800 font-outfit">Panel Kontrol Tracker</h2>
        <p class="text-xs text-slate-500 mt-0.5">Proses 1000 alumni/batch · Jeda 3–6 detik antar alumni · Rate-limit aman</p>
      </div>
      <div class="p-6 space-y-5">

        <% if (isAdmin) { %>
        <!-- Form Mulai -->
        <form action="/tracker/start" method="POST" id="startForm">
          <div class="mb-4">
            <label for="batchSize" class="block text-sm font-semibold text-slate-700 mb-1">Jumlah Alumni per Batch</label>
            <input type="number" id="batchSize" name="batchSize" value="1000" min="1" max="1000"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all">
            <p class="text-xs text-slate-400 mt-1">Maksimal 1000. Worker memproses 1 alumni setiap 3–6 detik secara berurutan.</p>
          </div>
          <button type="submit" id="btnStart"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 shadow-lg shadow-indigo-500/30 transition-all duration-200 hover:-translate-y-0.5"
            <%= workerStatus.status === 'running' ? 'disabled' : '' %>
            onclick="this.disabled=true; this.textContent='Memulai...'; this.form.submit();">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Mulai Batch Massal
          </button>
        </form>

        <% if (workerStatus.status === 'running') { %>
        <form action="/tracker/stop" method="POST">
          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
            Hentikan & Kosongkan Queue
          </button>
        </form>
        <% } %>

        <!-- Link ke Staging -->
        <a href="/staging" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold rounded-xl text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition-all duration-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Staging Area Verifikasi (<%= stats.perluVerifikasi.toLocaleString('id-ID') %>)
        </a>

        <% } else { %>
        <div class="px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-500 text-center">
          Hanya admin yang dapat memulai tracker.
        </div>
        <% } %>

        <!-- Info Mode -->
        <div class="px-4 py-3 rounded-xl bg-indigo-50 border border-indigo-100 text-xs text-indigo-700 space-y-1">
          <p class="font-bold">Mode Aktif: <code class="bg-indigo-100 px-1.5 py-0.5 rounded"><%= osintMode %></code></p>
          <p>Set <code>OSINT_MODE=real</code> di <code>.env</code> untuk scraping nyata via DuckDuckGo.</p>
        </div>
      </div>
    </div>

    <!-- Panel Kanan: Status Progres (realtime polling) -->
    <div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-800 font-outfit">Status Proses</h2>
          <p class="text-xs text-slate-500 mt-0.5">Update otomatis setiap 4 detik</p>
        </div>
        <button onclick="fetchStatus()" class="text-xs text-indigo-600 font-semibold hover:underline">Refresh</button>
      </div>
      <div class="p-6 space-y-4" id="status-panel">

        <!-- Progress Bar -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
            <span>Progress Sesi</span>
            <span id="progress-text"><%= workerStatus.progress %></span>
          </div>
          <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
            <div id="progress-bar"
              class="h-3 rounded-full bg-gradient-to-r from-indigo-500 to-violet-500 transition-all duration-700"
              style="width: <%= workerStatus.sessionTotal > 0 ? Math.round((workerStatus.sessionProcessed / workerStatus.sessionTotal) * 100) : 0 %>%">
            </div>
          </div>
        </div>

        <!-- Stat Grid -->
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-slate-50 rounded-xl p-3 text-center">
            <div class="text-xs text-slate-400 font-semibold uppercase tracking-wide">Diproses</div>
            <div class="text-2xl font-black text-slate-800 font-outfit mt-1" id="stat-processed"><%= workerStatus.sessionProcessed %></div>
          </div>
          <div class="bg-emerald-50 rounded-xl p-3 text-center">
            <div class="text-xs text-emerald-500 font-semibold uppercase tracking-wide">Auto-Approved</div>
            <div class="text-2xl font-black text-emerald-700 font-outfit mt-1" id="stat-approved"><%= workerStatus.sessionAutoApproved %></div>
          </div>
          <div class="bg-amber-50 rounded-xl p-3 text-center">
            <div class="text-xs text-amber-500 font-semibold uppercase tracking-wide">Staging</div>
            <div class="text-2xl font-black text-amber-700 font-outfit mt-1" id="stat-staging"><%= workerStatus.sessionStaging %></div>
          </div>
          <div class="bg-indigo-50 rounded-xl p-3 text-center">
            <div class="text-xs text-indigo-500 font-semibold uppercase tracking-wide">Queue Pending</div>
            <div class="text-2xl font-black text-indigo-700 font-outfit mt-1" id="stat-queue"><%= workerStatus.queuePending %></div>
          </div>
        </div>

        <% if (workerStatus.lastRun) { %>
        <div class="text-xs text-slate-400 text-center">
          Terakhir dijalankan: <%= new Date(workerStatus.lastRun).toLocaleString('id-ID') %>
        </div>
        <% } %>
        <% if (workerStatus.lastError) { %>
        <div class="px-3 py-2 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium">
          Error terakhir: <%= workerStatus.lastError %>
        </div>
        <% } %>
      </div>
    </div>

  </div><!-- end grid -->

  <!-- Cara Kerja -->
  <div class="mt-6 bg-white/80 border border-slate-200/60 rounded-2xl shadow-sm p-6">
    <h2 class="text-base font-bold text-slate-800 font-outfit mb-4">Cara Kerja Intelligent Tracker</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm">
      <% [
        ['1','Bangun Query','Nama + Kampus + Prodi + Tahun Lulus alumni dipakai sebagai kata kunci presisi.'],
        ['2','Scraping Web','DuckDuckGo Lite dicari query by query. Jeda 3–6 detik antar alumni.'],
        ['3','Scoring & Filter','Score ≥70% → auto-approve. Score 40–69% → staging verifikasi admin.'],
        ['4','Update Supabase','8 titik data (sosmed, email, pekerjaan, dll) diupdate otomatis (hanya field kosong).'],
      ].forEach(([n, title, desc]) => { %>
      <div class="flex gap-3">
        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center flex-shrink-0 text-xs"><%= n %></div>
        <div><p class="font-semibold text-slate-700"><%= title %></p><p class="text-slate-500 text-xs mt-0.5"><%= desc %></p></div>
      </div>
      <% }) %>
    </div>
  </div>

</div><!-- end page -->

<script>
// ── Polling Status Setiap 4 Detik ────────────────────────────────────────────
let pollingInterval = null;

function fetchStatus() {
  fetch('/tracker/status')
    .then(r => r.json())
    .then(s => {
      // Progress
      const pct = s.sessionTotal > 0 ? Math.round((s.sessionProcessed / s.sessionTotal) * 100) : 0;
      document.getElementById('progress-bar').style.width = pct + '%';
      document.getElementById('progress-text').textContent = s.progress || '0/0';

      // Stats
      document.getElementById('stat-processed').textContent = s.sessionProcessed || 0;
      document.getElementById('stat-approved').textContent  = s.sessionAutoApproved || 0;
      document.getElementById('stat-staging').textContent   = s.sessionStaging || 0;
      document.getElementById('stat-queue').textContent     = s.queuePending || 0;

      // Badge
      const badge = document.getElementById('status-badge');
      const isRunning = s.status === 'running';
      badge.className = `inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold border ${
        isRunning ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200'
      }`;
      badge.innerHTML = `<span class="w-2 h-2 rounded-full ${isRunning ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}"></span>
        ${isRunning ? 'Tracker Berjalan' : 'Tracker Siap'}`;

      // Hentikan polling jika selesai
      if (!isRunning && pollingInterval) {
        clearInterval(pollingInterval);
        pollingInterval = null;
      }
    })
    .catch(() => {}); // silent fail
}

// Mulai polling jika tracker berjalan
<% if (workerStatus.status === 'running') { %>
pollingInterval = setInterval(fetchStatus, 4000);
<% } %>
</script>

<%- include('partials/footer') %>
